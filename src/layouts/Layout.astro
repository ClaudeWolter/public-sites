---
import type { Locale } from '../i18n/translations';
import { translations } from '../i18n/translations';
import { routes } from '../i18n/routes';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  currentPage?: 'home' | 'equipment' | 'contact';
}

const { locale, title, description, currentPage = 'home' } = Astro.props;
const tr = translations[locale];
const year = new Date().getFullYear();

const homeUrls: Record<Locale, string> = {
  fr: '/fr/',
  de: '/de/',
  en: '/en/',
};

const equipmentUrls: Record<Locale, string> = {
  fr: `/fr/${routes.fr.equipment}/`,
  de: `/de/${routes.de.equipment}/`,
  en: `/en/${routes.en.equipment}/`,
};

const contactUrls: Record<Locale, string> = {
  fr: `/fr/${routes.fr.contact}/`,
  de: `/de/${routes.de.contact}/`,
  en: `/en/${routes.en.contact}/`,
};

const currentUrls = currentPage === 'equipment' ? equipmentUrls
  : currentPage === 'contact' ? contactUrls
  : homeUrls;
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description ?? tr.siteDescription} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Hreflang -->
    <link rel="alternate" hreflang="fr" href={currentUrls.fr} />
    <link rel="alternate" hreflang="de" href={currentUrls.de} />
    <link rel="alternate" hreflang="en" href={currentUrls.en} />
    <link rel="alternate" hreflang="x-default" href={currentUrls.fr} />
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col">

    <!-- Mobile menu toggle (pure CSS checkbox trick) -->
    <input type="checkbox" id="nav-toggle" class="hidden peer/nav" aria-hidden="true" />

    <!-- NAV -->
    <header class="bg-white shadow-sm sticky top-0 z-50">
      <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Navigation principale">
        <div class="flex items-center justify-between h-16">

          <!-- Logo -->
          <a href={homeUrls[locale]} class="flex items-center gap-2 font-bold text-xl text-primary-dark hover:text-primary transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <!-- Fencing sword / épée icon -->
              <line x1="2" y1="22" x2="18" y2="6" />
              <path d="M18 6 l3-3 1 1-3 3" />
              <path d="M14 10 l-2 2" />
              <circle cx="20" cy="4" r="1" fill="currentColor" />
            </svg>
            <span>FLE</span>
            <span class="hidden sm:inline text-sm font-normal text-gray-500">Rental</span>
          </a>

          <!-- Desktop nav links -->
          <div class="hidden md:flex items-center gap-6">
            <a href={homeUrls[locale]}
               class={`text-sm font-medium transition-colors hover:text-primary ${currentPage === 'home' ? 'text-primary border-b-2 border-accent pb-0.5' : 'text-gray-600'}`}>
              {tr.nav.home}
            </a>
            <a href={equipmentUrls[locale]}
               class={`text-sm font-medium transition-colors hover:text-primary ${currentPage === 'equipment' ? 'text-primary border-b-2 border-accent pb-0.5' : 'text-gray-600'}`}>
              {tr.nav.equipment}
            </a>
            <a href={contactUrls[locale]}
               class={`text-sm font-medium transition-colors hover:text-primary ${currentPage === 'contact' ? 'text-primary border-b-2 border-accent pb-0.5' : 'text-gray-600'}`}>
              {tr.nav.contact}
            </a>

            <!-- Language switcher desktop -->
            <div class="relative group">
              <button class="flex items-center gap-1 text-sm font-medium text-gray-600 hover:text-primary transition-colors py-1 px-2 rounded border border-gray-200 hover:border-primary">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="2" y1="12" x2="22" y2="12" />
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                </svg>
                <span>{locale.toUpperCase()}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </button>
              <div class="absolute right-0 mt-1 w-36 bg-white border border-gray-200 rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
                {(['fr', 'de', 'en'] as Locale[]).map((lang) => (
                  <a href={currentUrls[lang]}
                     class={`block px-4 py-2 text-sm hover:bg-gray-50 hover:text-primary transition-colors ${lang === locale ? 'text-primary font-semibold' : 'text-gray-700'} first:rounded-t-lg last:rounded-b-lg`}>
                    {tr.langNames[lang]}
                  </a>
                ))}
              </div>
            </div>
          </div>

          <!-- Mobile hamburger label -->
          <label for="nav-toggle" class="md:hidden cursor-pointer p-2 rounded hover:bg-gray-100 transition-colors" aria-label="Menu">
            <!-- Hamburger icon (shown when menu closed) -->
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-700 peer-checked/nav:hidden block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="3" y1="6" x2="21" y2="6" />
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
            <!-- Close icon (shown when menu open) -->
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-700 hidden peer-checked/nav:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </label>
        </div>

        <!-- Mobile menu (toggle via checkbox) -->
        <div class="md:hidden max-h-0 overflow-hidden peer-checked/nav:max-h-96 transition-all duration-300 ease-in-out">
          <div class="py-3 border-t border-gray-100 flex flex-col gap-1">
            <a href={homeUrls[locale]}
               class={`px-3 py-2 rounded text-sm font-medium transition-colors hover:bg-gray-50 hover:text-primary ${currentPage === 'home' ? 'text-primary bg-blue-50' : 'text-gray-700'}`}>
              {tr.nav.home}
            </a>
            <a href={equipmentUrls[locale]}
               class={`px-3 py-2 rounded text-sm font-medium transition-colors hover:bg-gray-50 hover:text-primary ${currentPage === 'equipment' ? 'text-primary bg-blue-50' : 'text-gray-700'}`}>
              {tr.nav.equipment}
            </a>
            <a href={contactUrls[locale]}
               class={`px-3 py-2 rounded text-sm font-medium transition-colors hover:bg-gray-50 hover:text-primary ${currentPage === 'contact' ? 'text-primary bg-blue-50' : 'text-gray-700'}`}>
              {tr.nav.contact}
            </a>
            <div class="border-t border-gray-100 mt-2 pt-2 flex gap-2 px-3">
              {(['fr', 'de', 'en'] as Locale[]).map((lang) => (
                <a href={currentUrls[lang]}
                   class={`text-xs px-2 py-1 rounded border transition-colors ${lang === locale ? 'bg-primary text-white border-primary' : 'border-gray-300 text-gray-600 hover:border-primary hover:text-primary'}`}>
                  {lang.toUpperCase()}
                </a>
              ))}
            </div>
          </div>
        </div>
      </nav>
    </header>

    <!-- MAIN CONTENT -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="bg-primary-dark text-white mt-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Brand -->
          <div>
            <div class="flex items-center gap-2 font-bold text-xl mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="2" y1="22" x2="18" y2="6" />
                <path d="M18 6 l3-3 1 1-3 3" />
                <path d="M14 10 l-2 2" />
              </svg>
              FLE Rental
            </div>
            <p class="text-blue-200 text-sm">Fédération Luxembourgeoise d'Escrime</p>
          </div>

          <!-- Contact -->
          <div>
            <h3 class="font-semibold text-white mb-3">{tr.footer.contact}</h3>
            <a href={`mailto:${tr.footer.email}`} class="text-blue-200 hover:text-white transition-colors text-sm">
              {tr.footer.email}
            </a>
          </div>

          <!-- Links -->
          <div>
            <h3 class="font-semibold text-white mb-3">Links</h3>
            <ul class="space-y-2 text-sm">
              <li>
                <a href="https://github.com/flearmory/public-sites" class="text-blue-200 hover:text-white transition-colors text-xs" target="_blank" rel="noopener noreferrer">
                  {tr.footer.agpl}
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="border-t border-blue-900 mt-8 pt-6 text-center text-blue-300 text-sm">
          {tr.footer.rights.replace('{year}', String(year))}
        </div>
      </div>
    </footer>

  </body>
</html>
