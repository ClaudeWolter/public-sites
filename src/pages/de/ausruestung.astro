---
import Layout from '../../layouts/Layout.astro';
import { translations } from '../../i18n/translations';
import { routes } from '../../i18n/routes';

const locale = 'de';
const tr = translations[locale];
const eq = tr.equipment;
---

<Layout locale={locale} title={`${eq.pageTitle} — ${tr.siteTitle}`} currentPage="equipment">

  <!-- PAGE HEADER -->
  <section class="bg-primary-dark text-white py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl md:text-4xl font-bold mb-4">{eq.pageTitle}</h1>
      <p class="text-blue-200 text-lg max-w-2xl mx-auto">{eq.pageSubtitle}</p>
    </div>
  </section>

  <!-- AVAILABILITY NOTE -->
  <section class="bg-blue-50 border-b border-blue-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex items-center gap-3 text-primary">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="8" x2="12" y2="12" />
          <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
        <p class="text-sm font-medium">{eq.availabilityNote}</p>
      </div>
    </div>
  </section>

  <!-- CATEGORY GRID -->
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {eq.categories.map((cat) => (
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex flex-col hover:shadow-md hover:-translate-y-1 transition-all duration-200">
            <div class="flex items-center justify-center w-12 h-12 rounded-lg bg-primary/10 text-primary mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {cat.id === 'armes' && <>
                  <line x1="2" y1="22" x2="18" y2="6" />
                  <path d="M18 6 l3-3 1 1-3 3" />
                  <path d="M14 10 l-2 2" />
                </>}
                {cat.id === 'masques' && <>
                  <path d="M12 2 C6.48 2 2 6.48 2 12 v3 a2 2 0 0 0 2 2 h16 a2 2 0 0 0 2-2 v-3 C22 6.48 17.52 2 12 2z" />
                  <line x1="8" y1="13" x2="16" y2="13" />
                </>}
                {cat.id === 'vetements' && <>
                  <path d="M20.38 3.46 L16 2 a4 4 0 0 1-8 0 L3.62 3.46 a2 2 0 0 0-1.34 2.23 l.58 3.57 a1 1 0 0 0 .99.84 H6 v10 c0 1.1.9 2 2 2 h8 c1.1 0 2-.9 2-2 V10 h2.15 a1 1 0 0 0 .99-.84 l.58-3.57 a2 2 0 0 0-1.34-2.23z" />
                </>}
                {cat.id === 'lames' && <>
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                </>}
                {cat.id === 'electrique' && <>
                  <rect x="2" y="7" width="20" height="14" rx="2" />
                  <path d="M16 3 H8" />
                  <path d="M12 3 v4" />
                  <circle cx="12" cy="14" r="3" />
                </>}
                {cat.id === 'competition' && <>
                  <rect x="3" y="3" width="18" height="14" rx="2" />
                  <line x1="3" y1="20" x2="21" y2="20" />
                  <line x1="12" y1="17" x2="12" y2="20" />
                  <polyline points="9 10 12 13 15 10" />
                </>}
                {cat.id === 'formation' && <>
                  <circle cx="12" cy="12" r="9" />
                  <path d="M9 9 h6 v6 h-6 z" />
                  <line x1="12" y1="3" x2="12" y2="9" />
                  <line x1="12" y1="15" x2="12" y2="21" />
                  <line x1="3" y1="12" x2="9" y2="12" />
                  <line x1="15" y1="12" x2="21" y2="12" />
                </>}
                {cat.id === 'divers' && <>
                  <polyline points="21 8 21 21 3 21 3 8" />
                  <rect x="1" y="3" width="22" height="5" />
                  <line x1="10" y1="12" x2="14" y2="12" />
                </>}
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-2 text-sm md:text-base">{cat.name}</h3>
            <p class="text-gray-500 text-xs md:text-sm flex-1 mb-4">{cat.description}</p>
            <a href={`/de/${routes.de.contact}/?cat=${cat.id}`}
               class="mt-auto text-center text-xs font-semibold text-primary border border-primary hover:bg-primary hover:text-white py-2 px-3 rounded-lg transition-colors">
              {eq.ctaEnquire}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BOTTOM LINK -->
  <section class="py-8 bg-gray-50 border-t border-gray-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-gray-600 mb-4">Möchten Sie mehrere Kategorien gleichzeitig anfragen?</p>
      <a href={`/de/${routes.de.contact}/`}
         class="inline-block bg-primary hover:bg-primary-light text-white font-semibold px-8 py-3 rounded-lg transition-colors">
        {tr.nav.contact}
      </a>
    </div>
  </section>

</Layout>
